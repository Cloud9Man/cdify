rules_version = '2';

// Order metadata includes names, email addresses, and customer messages.
// Writes are performed only by the trusted Cloud Function using the Admin SDK.
// The public website has no direct Firestore read or write access.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
